# Optional for local dev — each defaults to http://localhost:<port> when unset.
# For a server (e.g. EC2) set these to the PUBLIC address of the backend, then rebuild:
#   VITE_AUTH_SERVICE_URL=http://<EC2_PUBLIC_IP>:4000
VITE_AUTH_SERVICE_URL=http://localhost:4000
VITE_FARM_SERVICE_URL=http://localhost:4001
VITE_WORKER_SERVICE_URL=http://localhost:4002
# SP service: leave empty in dev (Vite proxies /api/sp -> :4003).
# In production set to e.g. http://<EC2_PUBLIC_IP>:4003 (no trailing slash, no /api/sp).
VITE_SP_SERVICE_URL=
